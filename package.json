{
  "name": "lacvo-market",
  "version": "2.0.52",
  "private": true,
  "description": "Reproducible frontend build for the VinhLac Market WordPress/WooCommerce theme portfolio snapshot.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tailwindcss -i ./assets/src/app.css -o ./assets/dist/app.css --watch",
    "build": "mkdir -p ./assets/dist && tailwindcss -i ./assets/src/app.css -o ./assets/dist/app.css --minify && cp ./assets/src/app.js ./assets/dist/app.js",
    "lint:js": "node --check ./assets/src/app.js",
    "test": "npm run lint:js && npm run build"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17"
  }
}
